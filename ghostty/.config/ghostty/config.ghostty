# Theme Settings
# theme = dark:Github Dark Dimmed,light:Github Light Default
theme = Github Dark Dimmed
background-opacity = 0.90
background-blur-radius = true

# Mouse settings
mouse-hide-while-typing = true

# Enable SSH environment variable compatibility (converts TERM from xterm-ghostty to xterm-256color).
# Enable automatic terminfo installation on remote hosts
# https://ghostty.org/docs/config/reference#shell-integration-features
shell-integration-features = ssh-env,ssh-terminfo

# Disable ligatures
font-feature = -calt

# vim:syn=bash
