#!/usr/bin/env bash

# Review pull-requests or local branches entirely in vim using "sindrets/diffview.nvim".
#
# Usage:
#   review              Prompt for review mode (GitHub PR or local branch)
#   review -p|--pr       Review a GitHub PR
#   review -l|--local     Review a local branch against another local branch

# Ensure we fail on errors
set -e

COLOR_NONE='\033[0m'
COLOR_YELLOW='\033[1;33m'
SYMBOL="${COLOR_YELLOW}▶${COLOR_NONE}"

# Check if gum is available
GUM_EXISTS=0
if command -v gum &>/dev/null; then
    GUM_EXISTS=1
fi

# Remember where we started so we can return and clean up on exit
ORIGINAL_DIR=$(pwd)
REPO_ROOT=$(git rev-parse --show-toplevel)
WORKTREE_DIR=""

# Yes/no prompt that does not exit; returns 0 for yes, 1 for no
function confirmYesNo() {
    local msg="$1"
    if [ $GUM_EXISTS -eq 1 ]; then
        gum confirm "$msg"
    else
        read -r -n 1 -p "$msg (y/N): " yn
        echo
        [[ "$yn" =~ ^[Yy]$ ]]
    fi
}

# Single-choice prompt; prints the chosen option (or nothing if cancelled)
function chooseOne() {
    local header="$1"
    shift
    if [ $GUM_EXISTS -eq 1 ]; then
        gum choose --header "$header" "$@"
    else
        printf '%s\n' "$@" | fzf --reverse --height=20 --border --prompt="${header} "
    fi
}

# Function to tear down the review worktree on exit
function cleanup() {
    # Leave the worktree before removing it
    cd "$ORIGINAL_DIR" 2>/dev/null || cd "$REPO_ROOT" 2>/dev/null || true

    if [ -n "$WORKTREE_DIR" ] && [ -d "$WORKTREE_DIR" ]; then
        if confirmYesNo "Remove review worktree (${WORKTREE_DIR})?"; then
            echo -e "${SYMBOL} Removing review worktree (${WORKTREE_DIR})"
            git -C "$REPO_ROOT" worktree remove --force "$WORKTREE_DIR" 2>/dev/null \
                || rm -rf "$WORKTREE_DIR"
            git -C "$REPO_ROOT" worktree prune
            rmdir "$(dirname "$WORKTREE_DIR")" 2>/dev/null || true
        else
            echo -e "${SYMBOL} Keeping review worktree. Re-open the review with:"
            echo -e "${SYMBOL}   cd \"${WORKTREE_DIR}\" && nvim -c :DiffviewOpen"
            echo -e "${SYMBOL} Remove it later with:"
            echo -e "${SYMBOL}   git -C \"${REPO_ROOT}\" worktree remove --force \"${WORKTREE_DIR}\""
        fi
    fi
}
trap cleanup EXIT

function continueOrExit() {
    local continueMsg="$1"
    local exitMetadata="${2:-""}"

    if [ $GUM_EXISTS -eq 1 ]; then
        gum confirm "$continueMsg" && return || {
            echo -e "${SYMBOL} Stopping review"
            [ -n "$exitMetadata" ] && echo -e "${SYMBOL} $exitMetadata"
            exit 0
        }
    else
        read -r -n 1 -p "Press (c) to continue reviewing: " c
        echo
        case "$c" in
            [Cc]*) return ;;
            *)
                echo -e "${SYMBOL} Stopping review"
                [ -n "$exitMetadata" ] && echo -e "${SYMBOL} $exitMetadata"
                exit 0
                ;;
        esac
    fi
}

# Shared tail of the review flow: HEAD in $WORKTREE_DIR is the change to
# review, and $1 is the ref to diff it against.
function runReview() {
    local baseRef="$1"

    env REVIEW_BASE="$baseRef" git stat
    continueOrExit "Review?"

    # Reset the worktree HEAD to the merge point so the full change shows as a working-tree diff
    local mergeCommit
    mergeCommit=$(git merge-base HEAD "$baseRef")
    git reset --soft "$mergeCommit"
    git reset  # to make everything unstaged
    nvim -c :DiffviewOpen  # to use diffview for the review

    # The worktree is disposable and removed on exit; nothing to reset on the real branch.
}

function reviewPr() {
    # Select PR number, branch, and base branch from currently open PRs
    local selection
    selection=$(gh pr list --json number,baseRefName,headRefName,title,url \
        --template '{{range .}}{{tablerow (printf "%-5v %-30v %-10v %v" .number .headRefName .baseRefName .url)}}{{end}}' \
        | fzf --reverse --height=20 --border --prompt="Select PR to review: ")

    if [[ -z $selection ]]; then
        echo -e "${COLOR_YELLOW}No PR selected${COLOR_NONE}"
        exit 0
    fi

    local prNumber prBaseBranch prUrl
    prNumber=$(echo "$selection" | awk '{print $1}')
    prBaseBranch=$(echo "$selection" | awk '{print $3}')
    prUrl=$(echo "$selection" | awk '{print $4}')

    echo -e "${SYMBOL} Starting review for PR #${prNumber} (${prUrl})"

    # Update the base branch from origin so the review diff is correct
    echo -e "${SYMBOL} Updating base branch (${prBaseBranch}) from origin"
    git fetch origin "$prBaseBranch"

    # Create an isolated worktree so the current directory is never touched
    WORKTREE_DIR="$(mktemp -d -t review-pr-XXXXXX)/worktree"
    echo -e "${SYMBOL} Creating review worktree (${WORKTREE_DIR})"
    git worktree add --detach "$WORKTREE_DIR" "origin/${prBaseBranch}"
    cd "$WORKTREE_DIR"

    # Checkout the desired review branch (detached, to avoid local branch collisions)
    echo -e "${SYMBOL} Checking out PR #${prNumber}"
    gh pr checkout "$prNumber" --detach

    runReview "origin/${prBaseBranch}"
}

function reviewLocalBranch() {
    # Select the branch to review from local branches
    local reviewBranch
    reviewBranch=$(git -C "$REPO_ROOT" for-each-ref --format='%(refname:short)' refs/heads/ \
        | fzf --reverse --height=20 --border --prompt="Select branch to review: ")

    if [[ -z $reviewBranch ]]; then
        echo -e "${COLOR_YELLOW}No branch selected${COLOR_NONE}"
        exit 0
    fi

    # Select the base branch to diff against
    local baseBranch
    baseBranch=$(git -C "$REPO_ROOT" for-each-ref --format='%(refname:short)' refs/heads/ \
        | grep -v -x "$reviewBranch" \
        | fzf --reverse --height=20 --border --prompt="Select base branch: ")

    if [[ -z $baseBranch ]]; then
        echo -e "${COLOR_YELLOW}No base branch selected${COLOR_NONE}"
        exit 0
    fi

    echo -e "${SYMBOL} Starting review of branch (${reviewBranch}) against (${baseBranch})"

    # Prefer the up-to-date remote-tracking ref for the base branch, if one exists
    local baseRef="$baseBranch"
    if git -C "$REPO_ROOT" show-ref --verify --quiet "refs/remotes/origin/${baseBranch}"; then
        echo -e "${SYMBOL} Updating base branch (${baseBranch}) from origin"
        git -C "$REPO_ROOT" fetch origin "$baseBranch"
        baseRef="origin/${baseBranch}"
    fi

    # Create an isolated worktree so the current directory is never touched
    WORKTREE_DIR="$(mktemp -d -t review-branch-XXXXXX)/worktree"
    echo -e "${SYMBOL} Creating review worktree (${WORKTREE_DIR})"
    git worktree add --detach "$WORKTREE_DIR" "$baseRef"
    cd "$WORKTREE_DIR"

    # Checkout the desired review branch (detached, to avoid local branch collisions)
    echo -e "${SYMBOL} Checking out branch (${reviewBranch})"
    git checkout --detach "$reviewBranch"

    runReview "$baseRef"
}

mode="${1:-}"
case "$mode" in
    -p|--pr)
        reviewPr
        ;;
    -l|--local)
        reviewLocalBranch
        ;;
    "")
        choice=$(chooseOne "What would you like to review?" "GitHub PR" "Local branch")
        case "$choice" in
            "GitHub PR") reviewPr ;;
            "Local branch") reviewLocalBranch ;;
            *)
                echo -e "${COLOR_YELLOW}No selection made${COLOR_NONE}"
                exit 0
                ;;
        esac
        ;;
    *)
        echo "Usage: review [-p|--pr] [-l|--local]" >&2
        exit 1
        ;;
esac
