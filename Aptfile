# Ubuntu packages installed by dots bootstrap. macOS uses the Brewfile instead.
#
# Packages that the running Ubuntu release does not provide are skipped. dive, glow,
# gum, and yq are not available from Ubuntu, and Neovim is installed with snap since
# apt's version is too old for the config.
bat             # better cat, installed as batcat
build-essential
curl
difftastic      # structural diffs for the git dl, ds, and dft aliases
fd-find         # find alternative, installed as fdfind
fzf             # Fuzzy finder
gh              # Github CLI
htop
jq
lazygit
ncurses-term    # extra terminfo entries such as tmux-256color
nnn
python3
ripgrep         # grep alternative
sd              # sed alternative
shellcheck      # diagnostics for shell scripts
tig             # git TUI
tmux
tree
wget
xclip
zsh
