#!/usr/bin/env bash

# Review pull-requests entirely in vim using "sindrets/diffview.nvim".

# Ensure we fail on errors
set -e

COLOR_NONE='\033[0m'
COLOR_YELLOW='\033[1;33m'
SYMBOL="${COLOR_YELLOW}▶${COLOR_NONE}"

# Check if gum is available
GUM_EXISTS=0
if command -v gum &>/dev/null; then
    GUM_EXISTS=1
fi

# Store the current branch to switch back to it later
ORIGINAL_BRANCH=$(git branch --show-current)

# Function to ensure we return to the original branch on exit
function cleanup() {
    # Check if there are any uncommitted changes
    if git diff-index --quiet HEAD --; then
        echo -e "${SYMBOL} Switching back to the original branch (${ORIGINAL_BRANCH})"
        git switch "$ORIGINAL_BRANCH"
    else
        echo -e "${SYMBOL} Uncommitted changes detected. Staying on the current branch."
    fi
}
trap cleanup EXIT

function continueOrExit() {
    local continueMsg="$1"
    local exitMetadata="${2:-""}"

    if [ $GUM_EXISTS -eq 1 ]; then
        gum confirm "$continueMsg" && return || {
            echo -e "${SYMBOL} Stopping review"
            [ -n "$exitMetadata" ] && echo -e "${SYMBOL} $exitMetadata"
            exit 0
        }
    else
        read -r -n 1 -p "Press (c) to continue reviewing: " c
        echo
        case "$c" in
            [Cc]*) return ;;
            *)
                echo -e "${SYMBOL} Stopping review"
                [ -n "$exitMetadata" ] && echo -e "${SYMBOL} $exitMetadata"
                exit 0
                ;;
        esac
    fi
}

# Select PR number, branch, and base branch from currently open PRs
selection=$(gh pr list --json number,baseRefName,headRefName,title,url \
    --template '{{range .}}{{tablerow (printf "%-5v %-30v %-10v %v" .number .headRefName .baseRefName .url)}}{{end}}' \
    | fzf --reverse --height=20 --border --prompt="Select PR to review: ")

if [[ -z $selection ]]; then
    echo -e "${COLOR_YELLOW}No PR selected${COLOR_NONE}"
    exit 0
fi

PR_NUMBER=$(echo "$selection" | awk '{print $1}')
PR_BRANCH=$(echo "$selection" | awk '{print $2}')
PR_BASE_BRANCH=$(echo "$selection" | awk '{print $3}')
PR_URL=$(echo "$selection" | awk '{print $4}')

echo -e "${SYMBOL} Starting review for PR #${PR_NUMBER} (${PR_URL})"

# Update origin base branch so the review is correct
echo -e "${SYMBOL} Updating base branch (${PR_BASE_BRANCH}) from origin"
git fetch origin
git switch "$PR_BASE_BRANCH"
git pull origin "$PR_BASE_BRANCH"

# Checkout the desired review branch and show stats
echo -e "${SYMBOL} Checking out PR #${PR_NUMBER}"
gh pr checkout "$PR_NUMBER"

# Show stats from PR branch to remote origin default branch
env REVIEW_BASE="${PR_BASE_BRANCH}" git stat
continueOrExit "Review PR?"

# Reset PR branch to merge point and open in vim
mergeCommit=$(git merge-base HEAD origin/"$PR_BASE_BRANCH")
git reset --soft "$mergeCommit"
git reset  # to make everything unstaged
nvim -c :DiffviewOpen  # to use fugitive for the review

continueOrExit "Reset PR branch back to origin?" "Run the following to reset: \"git reset --hard origin/${PR_BRANCH}\""

# Reset PR branch back to remote
git reset --hard origin/"$PR_BRANCH"
