#!/usr/bin/env bash

# Review pull-requests entirely in vim using "sindrets/diffview.nvim".

# Ensure we fail on errors
set -e

COLOR_NONE='\033[0m'
COLOR_YELLOW='\033[1;33m'
SYMBOL="${COLOR_YELLOW}▶${COLOR_NONE}"

# Check if gum is available
GUM_EXISTS=0
if command -v gum &>/dev/null; then
    GUM_EXISTS=1
fi

# Remember where we started so we can return and clean up on exit
ORIGINAL_DIR=$(pwd)
REPO_ROOT=$(git rev-parse --show-toplevel)
WORKTREE_DIR=""

# Yes/no prompt that does not exit; returns 0 for yes, 1 for no
function confirmYesNo() {
    local msg="$1"
    if [ $GUM_EXISTS -eq 1 ]; then
        gum confirm "$msg"
    else
        read -r -n 1 -p "$msg (y/N): " yn
        echo
        [[ "$yn" =~ ^[Yy]$ ]]
    fi
}

# Function to tear down the review worktree on exit
function cleanup() {
    # Leave the worktree before removing it
    cd "$ORIGINAL_DIR" 2>/dev/null || cd "$REPO_ROOT" 2>/dev/null || true

    if [ -n "$WORKTREE_DIR" ] && [ -d "$WORKTREE_DIR" ]; then
        if confirmYesNo "Remove review worktree (${WORKTREE_DIR})?"; then
            echo -e "${SYMBOL} Removing review worktree (${WORKTREE_DIR})"
            git -C "$REPO_ROOT" worktree remove --force "$WORKTREE_DIR" 2>/dev/null \
                || rm -rf "$WORKTREE_DIR"
            git -C "$REPO_ROOT" worktree prune
            rmdir "$(dirname "$WORKTREE_DIR")" 2>/dev/null || true
        else
            echo -e "${SYMBOL} Keeping review worktree. Re-open the review with:"
            echo -e "${SYMBOL}   cd \"${WORKTREE_DIR}\" && nvim -c :DiffviewOpen"
            echo -e "${SYMBOL} Remove it later with:"
            echo -e "${SYMBOL}   git -C \"${REPO_ROOT}\" worktree remove --force \"${WORKTREE_DIR}\""
        fi
    fi
}
trap cleanup EXIT

function continueOrExit() {
    local continueMsg="$1"
    local exitMetadata="${2:-""}"

    if [ $GUM_EXISTS -eq 1 ]; then
        gum confirm "$continueMsg" && return || {
            echo -e "${SYMBOL} Stopping review"
            [ -n "$exitMetadata" ] && echo -e "${SYMBOL} $exitMetadata"
            exit 0
        }
    else
        read -r -n 1 -p "Press (c) to continue reviewing: " c
        echo
        case "$c" in
            [Cc]*) return ;;
            *)
                echo -e "${SYMBOL} Stopping review"
                [ -n "$exitMetadata" ] && echo -e "${SYMBOL} $exitMetadata"
                exit 0
                ;;
        esac
    fi
}

# Select PR number, branch, and base branch from currently open PRs
selection=$(gh pr list --json number,baseRefName,headRefName,title,url \
    --template '{{range .}}{{tablerow (printf "%-5v %-30v %-10v %v" .number .headRefName .baseRefName .url)}}{{end}}' \
    | fzf --reverse --height=20 --border --prompt="Select PR to review: ")

if [[ -z $selection ]]; then
    echo -e "${COLOR_YELLOW}No PR selected${COLOR_NONE}"
    exit 0
fi

PR_NUMBER=$(echo "$selection" | awk '{print $1}')
PR_BRANCH=$(echo "$selection" | awk '{print $2}')
PR_BASE_BRANCH=$(echo "$selection" | awk '{print $3}')
PR_URL=$(echo "$selection" | awk '{print $4}')

echo -e "${SYMBOL} Starting review for PR #${PR_NUMBER} (${PR_URL})"

# Update the base branch from origin so the review diff is correct
echo -e "${SYMBOL} Updating base branch (${PR_BASE_BRANCH}) from origin"
git fetch origin "$PR_BASE_BRANCH"

# Create an isolated worktree so the current directory is never touched
WORKTREE_DIR="$(mktemp -d -t review-pr-XXXXXX)/worktree"
echo -e "${SYMBOL} Creating review worktree (${WORKTREE_DIR})"
git worktree add --detach "$WORKTREE_DIR" "origin/${PR_BASE_BRANCH}"
cd "$WORKTREE_DIR"

# Checkout the desired review branch (detached, to avoid local branch collisions)
echo -e "${SYMBOL} Checking out PR #${PR_NUMBER}"
gh pr checkout "$PR_NUMBER" --detach

# Show stats from PR branch to the remote base branch
env REVIEW_BASE="origin/${PR_BASE_BRANCH}" git stat
continueOrExit "Review PR?"

# Reset the worktree HEAD to the merge point so the full PR shows as a working-tree diff
mergeCommit=$(git merge-base HEAD origin/"$PR_BASE_BRANCH")
git reset --soft "$mergeCommit"
git reset  # to make everything unstaged
nvim -c :DiffviewOpen  # to use diffview for the review

# The worktree is disposable and removed on exit; nothing to reset on the real branch.
